{
  "manifest_version": 3,
  "name": "Syapa Meeting Recorder",
  "version": "0.1.0",
  "description": "Capture and organize meeting notes from your browser tab.",
  "action": {
    "default_title": "Open Syapa recorder",
    "default_icon": {
      "16": "icons/syapa-16.png",
      "32": "icons/syapa-32.png",
      "48": "icons/syapa-48.png",
      "128": "icons/syapa-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabCapture",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/syapa-16.png",
    "32": "icons/syapa-32.png",
    "48": "icons/syapa-48.png",
    "128": "icons/syapa-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "114"
}
