# Database (PostgreSQL on Neon or Local)
DATABASE_URL="postgresql://localhost:5432/syapa"
DIRECT_URL="postgresql://localhost:5432/syapa"

# LLM (Gemma 4 served by Ollama OpenAI-compatible endpoint)
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="gemma4:12b"
LLM_TIMEOUT_MS=60000

# Embeddings (DigitalOcean Serverless Inference or local Ollama)
# If using DigitalOcean Serverless:
# EMBED_BASE_URL="https://inference.digitalocean.com/v1"
# EMBED_API_KEY="your-do-api-key"
# EMBED_MODEL="Qwen/Qwen3-Embedding-0.6B"
# EMBED_DIM=1024
#
# Defaulting to local Ollama OpenAI-compatible embeddings:
EMBED_BASE_URL="http://localhost:11434/v1"
EMBED_API_KEY=""
EMBED_MODEL="nomic-embed-text"
EMBED_DIM=768

# Speech-to-Text (ElevenLabs Scribe Realtime)
ELEVENLABS_API_KEY=""

# Auth secret
BETTER_AUTH_SECRET="syapa-super-secret-development-key-32chars"
BETTER_AUTH_URL="http://localhost:3000"

# CORS & Extension Configuration
EXTENSION_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SMOOTH_SCROLL=true
